/* secchi — package-intelligence dashboard */

Screen {
    background: #000000;
    layers: base overlay;
}

/* ── Custom header bar ── */

SecchiHeader {
    dock: top;
    height: 3;
    background: #020202;
    color: #E5E7EB;
    border-bottom: solid #3A3A3A;
}

SecchiHeader #header-brand {
    width: 12;
    height: 1;
    content-align: left middle;
    padding: 0 1;
    margin: 1 1 0 0;
    background: #7CFFB2;
    color: #00160D;
    text-style: bold;
}

SecchiHeader #header-product {
    width: 1fr;
    height: 1;
    content-align: left middle;
    padding: 0 1;
    margin: 1 0 0 0;
    color: #E5E7EB;
    text-style: bold;
}

SecchiHeader #header-right {
    width: auto;
    height: 1;
    content-align: right middle;
    padding: 0 1;
    margin: 1 0 0 0;
    background: #243D34;
    color: #E5E7EB;
}

/* ── Custom footer/status bar ── */

SecchiFooter {
    dock: bottom;
    height: 2;
    background: #0F0F0F;
    color: #9CA3AF;
    border-top: solid #3A3A3A;
}

SecchiFooter #footer-left {
    width: 1fr;
    height: 1;
    content-align: left middle;
    padding: 0;
}

SecchiFooter #footer-right {
    width: auto;
    height: 1;
    content-align: right middle;
    padding: 0;
}

/* ── Sidebar ── */

Sidebar {
    width: 36;
    height: 100%;
    background: #020202;
    border-right: solid #3A3A3A;
    padding: 0 1;
    overflow: hidden;
}

Sidebar:focus {
    border-right: solid #3A3A3A;
}

#sidebar-list {
    width: 100%;
    height: 1fr;
}

Sidebar .sidebar-title {
    text-style: bold;
    color: #3B82F6;
    padding: 1 0 0 0;
    width: 100%;
}

Sidebar .sidebar-section {
    color: #9CA3AF;
    text-style: bold;
    padding: 1 0 0 0;
    width: 100%;
}

SidebarItem {
    padding: 0 1;
    width: 100%;
    height: 1;
    color: #E5E7EB;
}

SidebarItem:hover {
    background: #101010;
}

.sidebar-item--selected {
    background: #1D4ED8;
    color: #FFFFFF;
    text-style: bold;
}

.sidebar-promo {
    width: 100%;
    height: 8;
    padding: 1;
    margin: 1 0 0 0;
    border: solid #3A3A3A;
    background: #111111;
    color: #FFFFFF;
}

/* ── Main content ── */

#main-content {
    width: 1fr;
    height: 100%;
    background: #000000;
}

#detail-view {
    width: 1fr;
    height: 1fr;
}

#detail-content {
    width: 1fr;
    height: 1fr;
    padding: 1 1 2 1;
}

#summary-row {
    height: 12;
    padding: 0 1 1 0;
}

#project-card {
    width: 3fr;
    height: 11;
    padding: 1;
    margin: 0 2 0 0;
    border: solid #3A3A3A;
    background: #050505;
}

#project-title {
    height: 1;
    padding: 0;
    text-style: bold;
    color: #39D353;
}

/* ── Project metadata ── */

#project-meta-row {
    height: 1;
    padding: 0;
    margin: 1 0 0 0;
}

.project-meta-label {
    width: auto;
    height: 1;
    margin: 0 1 0 0;
    color: #6B7280;
}

.source-icons {
    width: auto;
    height: 1;
    margin: 0 2 0 0;
    color: #E5E7EB;
}

.license-ribbon {
    width: auto;
    height: 1;
    padding: 0 1;
    background: #19091D;
    color: #E5E7EB;
    border-left: solid #C026D3;
    border-right: solid #C026D3;
}

#website-link {
    height: 1;
    padding: 0;
}

.badge {
    height: 1;
    width: auto;
    padding: 0 1;
    margin: 0 1 0 0;
    border: solid #3A3A3A;
    color: #E5E7EB;
    content-align: center middle;
}

.badge--link {
    color: #22D3EE;
}

/* ── Stat cards ── */

#stat-cards {
    width: 4fr;
    height: 11;
    layout: grid;
    grid-size: 3 2;
    grid-gutter: 1 1;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1fr 1fr;
    padding: 0;
}

.stat-card {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    margin: 0;
    border: solid #3A3A3A;
    background: #111111;
    color: #E5E7EB;
}

.stat-card-label {
    height: 1;
    color: #9CA3AF;
    content-align: center middle;
}

.stat-card-value {
    height: 2;
    color: #39D353;
    content-align: center middle;
    text-style: bold;
}

.stat-card-delta {
    height: 1;
    color: #9CA3AF;
    content-align: center middle;
}

/* ── Tabs ── */

#detail-tabs {
    height: 1fr;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: transparent;
}

TabPane {
    padding: 1 0;
    height: 1fr;
}

.tab-scroll {
    height: 1fr;
    padding: 0 1;
}

.pane-block {
    height: auto;
    padding: 0 1;
}

.pane-heading {
    height: auto;
    color: #3B82F6;
    text-style: bold;
}

/* ── Overview grid ── */

#overview-tab {
    height: auto;
}

.overview-row {
    height: 10;
    padding: 0 0 1 0;
}

.overview-row--bottom {
    height: 7;
    padding: 0;
}

Panel {
    width: 1fr;
    height: 1fr;
    border: solid #3A3A3A;
    background: #050505;
    padding: 1 1 0 1;
    margin: 0 1 0 0;
    overflow: hidden;
    border-title-color: #3B82F6;
    border-title-style: bold;
}

Panel.panel--wide {
    width: 2fr;
}

.overview-split {
    width: 1fr;
    height: 1fr;
    padding: 0;
    margin: 0 1 0 0;
}

.overview-split Panel {
    margin: 0 1 0 0;
}

.panel-body {
    height: 1fr;
}

.panel-caption {
    height: 1;
    color: #6B7280;
    text-style: italic dim;
    padding: 0;
    dock: bottom;
}

.ov-summary {
    height: 1;
    margin-top: 1;
}

#ov-trend-chart {
    height: 1fr;
    width: 1fr;
}

/* ── Tables ── */

DataTable {
    background: #050505;
    height: auto;
}

DataTable > .datatable--header {
    background: #111111;
    color: #E5E7EB;
    text-style: bold;
}

/* ── Error / loading ── */

#error-view {
    color: #EF4444;
    padding: 2 2;
    border: solid #3A3A3A;
}

#loading-view {
    padding: 2 2;
    color: #9CA3AF;
}

/* ── Modals ── */

SearchScreen {
    align: center middle;
    background: #000000 60%;
}

#search-box {
    width: 70;
    height: auto;
    max-height: 80%;
    background: #050505;
    border: solid #3A3A3A;
    padding: 1 2;
}

#search-results {
    height: auto;
    max-height: 18;
    margin: 1 0 0 0;
    background: #050505;
}

HelpScreen {
    align: center middle;
    background: #000000 60%;
}

#help-box {
    width: 60;
    height: auto;
    background: #050505;
    color: #E5E7EB;
    border: solid #3A3A3A;
    padding: 1 2;
}

#help-body {
    height: auto;
    padding: 1 0;
    color: #ffffff;
}

.modal-title {
    text-style: bold;
    color: #ffffff;
    width: 100%;
}

.modal-hint {
    width: 100%;
    color: #ffffff;
}

/* ── Scrollbars ── */

Scrollbar {
    scrollbar-color: #3A3A3A;
    scrollbar-color-hover: #3B82F6;
    scrollbar-size-vertical: 1;
}
