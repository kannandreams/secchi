/* pkgwatch — package-intelligence dashboard (Tokyo Night) */

Screen {
    background: $background;
    layers: base overlay;
}

/* ── Custom header bar ── */

PkgWatchHeader {
    dock: top;
    height: 1;
    background: $primary-darken-3;
    color: $text;
}

PkgWatchHeader #header-left {
    width: 1fr;
    height: 1;
    content-align: left middle;
    padding: 0 1;
}

PkgWatchHeader #header-right {
    width: auto;
    height: 1;
    content-align: right middle;
    padding: 0 1;
    color: $text-muted;
}

/* ── Custom footer/status bar ── */

PkgWatchFooter {
    dock: bottom;
    height: 1;
    background: $primary-darken-3;
    color: $text-muted;
}

PkgWatchFooter #footer-left {
    width: 1fr;
    height: 1;
    content-align: left middle;
    padding: 0 1;
}

PkgWatchFooter #footer-right {
    width: auto;
    height: 1;
    content-align: right middle;
    padding: 0 1;
}

/* ── Sidebar ── */

Sidebar {
    width: 28;
    height: 100%;
    background: $panel-darken-1;
    border-right: tall $primary-darken-2;
    padding: 0 1;
    overflow-y: auto;
}

Sidebar:focus {
    border-right: tall $primary;
}

Sidebar .sidebar-title {
    text-style: bold;
    color: $accent;
    padding: 1 0 0 0;
    width: 100%;
}

Sidebar .sidebar-section {
    color: $text-muted;
    text-style: bold;
    padding: 1 0 0 0;
    width: 100%;
}

SidebarItem {
    padding: 0 1;
    width: 100%;
    height: 1;
    color: $text;
}

SidebarItem:hover {
    background: $boost;
}

.sidebar-item--selected {
    background: $primary-darken-1;
    text-style: bold;
}

#shortcuts-box {
    height: auto;
    border-top: tall $primary-darken-2;
    margin: 1 0 0 0;
    padding: 1 0 0 0;
}

.shortcuts-title {
    color: $text-muted;
    text-style: bold;
    width: 100%;
}

.shortcuts-body {
    color: $text-muted;
    width: 100%;
}

/* ── Main content ── */

#main-content {
    width: 1fr;
    height: 100%;
    background: $background;
}

#detail-view {
    width: 1fr;
    height: 1fr;
}

#detail-content {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#detail-header {
    height: auto;
    padding: 1 0 0 0;
    text-style: bold;
}

/* ── Badges ── */

#badge-row {
    height: 3;
    padding: 0 0 1 0;
}

.badge {
    height: 3;
    width: auto;
    padding: 0 1;
    margin: 0 1 0 0;
    border: round $primary-darken-2;
    color: $text;
    content-align: center middle;
}

.badge--link {
    color: $accent;
}

/* ── Stat cards ── */

#stat-cards {
    height: 5;
    padding: 0 0 1 0;
}

.stat-card {
    width: 1fr;
    height: 5;
    padding: 0 1;
    margin: 0 1 0 0;
    border: round $primary-darken-2;
    background: $surface;
}

/* ── Tabs ── */

#detail-tabs {
    height: 1fr;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: transparent;
}

TabPane {
    padding: 1 0;
    height: 1fr;
}

.tab-scroll {
    height: 1fr;
    padding: 0 1;
}

.pane-block {
    height: auto;
    padding: 0 1;
}

.pane-heading {
    height: auto;
    color: $accent;
    text-style: bold;
}

/* ── Overview grid ── */

#overview-tab {
    height: auto;
}

.overview-row {
    height: 14;
    padding: 0 0 1 0;
}

.overview-row--bottom {
    height: 12;
}

Panel {
    width: 1fr;
    height: 1fr;
    border: round $primary-darken-2;
    background: $surface;
    padding: 0 1;
    margin: 0 1 0 0;
    border-title-color: $accent;
    border-title-style: bold;
}

Panel.panel--wide {
    width: 2fr;
}

.panel-body {
    height: 1fr;
}

.panel-caption {
    height: 1;
    color: $text-muted;
    text-style: italic;
    dock: bottom;
}

.ov-summary {
    height: 1;
}

#ov-trend-chart {
    height: 1fr;
    width: 1fr;
}

/* ── Tables ── */

DataTable {
    background: $surface;
    height: auto;
}

DataTable > .datatable--header {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

/* ── Error / loading ── */

#error-view {
    color: $error;
    padding: 2 2;
    border: round $error;
}

#loading-view {
    padding: 2 2;
    color: $text-muted;
}

/* ── Modals ── */

SearchScreen {
    align: center middle;
    background: $background 60%;
}

#search-box {
    width: 70;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#search-results {
    height: auto;
    max-height: 18;
    margin: 1 0 0 0;
    background: $surface;
}

HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help-box {
    width: 60;
    height: auto;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#help-body {
    height: auto;
    padding: 1 0;
}

.modal-title {
    text-style: bold;
    color: $accent;
    width: 100%;
}

.modal-hint {
    width: 100%;
    color: $text-muted;
}

/* ── Scrollbars ── */

Scrollbar {
    scrollbar-color: $primary-darken-2;
    scrollbar-color-hover: $primary;
    scrollbar-size-vertical: 1;
}
